# Copy to .env to override the defaults baked into docker-compose.yml.
# The stack runs without this file; these are here so the credentials are not
# hard-coded when it runs anywhere that matters.

# Comma-separated. Admin keys get full access; device keys are scoped to
# enrollment, heartbeats, compliance reports and group policy reads.
GATEWAY_ADMIN_KEYS=fleet-admin-key
GATEWAY_DEVICE_KEYS=fleet-device-key

# The single admin key the dashboard uses server-side.
DASHBOARD_API_KEY=fleet-admin-key
